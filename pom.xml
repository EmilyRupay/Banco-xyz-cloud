<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>cl.duoc.banco</groupId>
    <artifactId>banco-xyz-cloud</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>banco-xyz-cloud</name>
    <description>Banco XYZ - Modernizacion: Spring Batch, BFF por canal y microservicios con Spring Cloud</description>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
    </properties>

    <modules>
        <!-- Infraestructura Spring Cloud -->
        <module>config-server</module>
        <module>eureka-server</module>
        <module>auth-server</module>
        <module>gateway</module>
        <!-- Microservicios de negocio -->
        <module>customers-service</module>
        <module>accounts-service</module>
        <module>payments-service</module>
        <module>notification-service</module>
        <!-- Backend for Frontend (uno por canal) -->
        <module>bff-web</module>
        <module>bff-mobile</module>
        <module>bff-atm</module>
        <!-- Procesos batch migrados desde el legacy -->
        <module>batch-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
